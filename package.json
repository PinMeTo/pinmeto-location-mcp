{
  "name": "@pinmeto/pinmeto-location-mcp",
  "version": "4.3.0",
  "description": "PinMeTo Location MCP",
  "main": "index.js",
  "scripts": {
    "prebuild": "node scripts/generate-version.mjs",
    "pretest": "npm run build",
    "build": "npm run clean && node manifest.js && tsc && cp package.json build/ && node update-build-version.js",
    "build:test": "VERSION_POSTFIX=test-$(date -u +%Y%m%dT%H%M%SZ) npm run build",
    "bundle": "node scripts/build-bundle.mjs",
    "pack:test": "npm run build:test && npx @anthropic-ai/mcpb pack && npm run verify:mcpb",
    "clean": "node -e \"require('fs').rmSync('build', {recursive: true, force: true})\"",
    "prepare": "npm run build",
    "start": "node --env-file=.env.local build/index.js",
    "format": "prettier --write \"**/*.{js,ts}\"",
    "inspector": "npx @modelcontextprotocol/inspector node --env-file=.env.local build/index.js",
    "test": "vitest --run",
    "test:stdio-eras": "npm run build && vitest --run tests/stdio-protocol-eras.test.ts",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "release:prepare": "changeset status --verbose",
    "release:version": "changeset version && node scripts/format-changelog.js && node scripts/update-readme-badges.js",
    "verify:mcpb": "node scripts/verify-mcpb.mjs",
    "release:draft": "npm test && npm run build && npm run bundle && npx @anthropic-ai/mcpb pack && npm run verify:mcpb && node scripts/create-gh-release.js",
    "release:publish": "gh release edit $(git describe --tags --abbrev=0) --draft=false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PinMeTo/pinmeto-location-mcp"
  },
  "keywords": [
    "mcp"
  ],
  "bin": {
    "pinmeto-location-mcp": "./build/index.js"
  },
  "author": "pinmeto",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/PinMeTo/pinmeto-location-mcp/issues"
  },
  "homepage": "https://github.com/PinMeTo/pinmeto-location-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "axios": "^1.16.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.5.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
